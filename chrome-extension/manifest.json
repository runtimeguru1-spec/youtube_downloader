{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "1.1.0",
  "description": "Check available qualities and download YouTube videos/audio using your own connected YouTube session. No local install or server required.",

  "permissions": ["activeTab", "tabs", "downloads", "storage"],
  "host_permissions": [
    "https://all-social-media-downloader-production.up.railway.app/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
